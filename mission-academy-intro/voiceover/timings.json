      ],
      "startSeconds": 12.6,
      "endSeconds": 21.4
    },
    {
      "scene": "s4",
      "text": "من التعليم والتدريب، إلى البحث العلمي، والمؤتمرات والفعاليات؛ مسارات تتكامل لدعم التطوير المهني.",
      "chunks": [
        {
          "text": "من التعليم والتدريب،",
          "from": 735,
          "to": 778
        },
        {
          "text": "إلى البحث العلمي،",
          "from": 782,
          "to": 822
