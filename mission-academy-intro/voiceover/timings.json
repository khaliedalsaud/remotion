      "startSeconds": 0.4,
      "endSeconds": 4.07
    },
    {
      "scene": "s2",
      "text": "تبدأ بالتعلّم، وتنمو بالتطبيق، وتستمر بالتطوير. هنا يأتي دور أكاديمية ميشن.",
      "chunks": [
        {
          "text": "تبدأ بالتعلّم،",
          "from": 162,
          "to": 198
        },
        {
          "text": "وتنمو بالتطبيق،",
          "from": 198,
          "to": 238
        },
        {
          "text": "وتستمر بالتطوير.",
          "from": 238,
          "to": 284
        },
        {
          "text": "هنا يأتي دور أكاديمية ميشن.",
          "from": 288,
          "to": 350
